    "test": "node tests/run-all.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0"
  },
  "files": [
    "bin",
    "lib",
    "qml",
    "tests",
    "README.md",
    "TECHNICAL.md",
    "DEVELOPMENT.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "os": [
    "linux"
  ]
}
