{
  "name": "@firstpick/pi-package-natural-conversation",
  "version": "0.1.2",
  "description": "Safe per-process Natural Conversation Mode for Pi, with /talk commands and read-only tool constraints.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Firstp1ck/npm-packages/tree/main/pi-package-natural-conversation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Firstp1ck/npm-packages.git",
    "directory": "pi-package-natural-conversation"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "conversation",
    "voice",
    "talk"
  ],
  "pi": {
    "extensions": [
      "./extensions/natural-conversation.ts"
    ]
  },
  "exports": {
    "./controller": "./lib/conversation-controller.mjs",
    "./native-audio-loop": "./lib/native-audio-loop.mjs",
    "./setup-wizard": "./lib/setup-wizard.mjs",
    "./voice-config": "./lib/voice-config.mjs",
    "./voice-switch": "./lib/voice-switch.mjs"
  },
  "scripts": {
    "check": "node --check lib/conversation-controller.mjs && node --check lib/native-audio-loop.mjs && node --check lib/native-audio-companion.mjs && node --check lib/setup-wizard.mjs && node --check lib/voice-config.mjs && node --test tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@firstpick/pi-utils": "^0.2.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "files": [
    "extensions",
    "lib",
    "tests",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  }
}
