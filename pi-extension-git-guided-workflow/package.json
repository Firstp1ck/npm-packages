{
  "name": "@firstpick/pi-extension-git-guided-workflow",
  "version": "0.1.0",
  "description": "Guided Git workflow for Pi TUI and WebUI with explicit commit and push safeguards.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Firstp1ck/pi-coding-agent-forge/tree/main/pi-extension-git-guided-workflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Firstp1ck/pi-coding-agent-forge.git",
    "directory": "pi-extension-git-guided-workflow"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "git",
    "commit",
    "tui",
    "webui",
    "rpc"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "prompts": [
      "./node_modules/@firstpick/pi-prompts-git-pr/prompts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --experimental-strip-types --check index.ts && node --experimental-strip-types --check src/core.ts"
  },
  "dependencies": {
    "@firstpick/pi-prompts-git-pr": "^0.1.6"
  },
  "bundledDependencies": [
    "@firstpick/pi-prompts-git-pr"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "files": [
    "index.ts",
    "src/core.ts",
    "README.md",
    "TECHNICAL.md",
    "DEVELOPMENT.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  }
}
