{
  "name": "@firstpick/pi-package-questionnaire",
  "version": "0.1.0",
  "description": "Native TUI and RPC questionnaires for the Pi coding agent, with resumable clarification.",
  "license": "MIT",
  "homepage": "https://github.com/Firstp1ck/pi-coding-agent-forge/tree/main/pi-package-questionnaire#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Firstp1ck/pi-coding-agent-forge.git",
    "directory": "pi-package-questionnaire"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "skill",
    "questionnaire",
    "tui",
    "rpc"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "node --experimental-strip-types --check index.ts && find src -type f -name '*.ts' -print0 | sort -z | xargs -0 -r -n1 node --experimental-strip-types --check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "files": [
    "index.ts",
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  }
}
