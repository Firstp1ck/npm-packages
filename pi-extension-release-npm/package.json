{
  "name": "@firstpick/pi-extension-release-npm",
  "version": "0.4.5",
  "description": "Pi command to run npm package release workflow with publish confirmation.",
  "license": "MIT",
  "homepage": "https://github.com/Firstp1ck/pi-coding-agent-forge/tree/main/pi-extension-release-npm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Firstp1ck/pi-coding-agent-forge.git",
    "directory": "pi-extension-release-npm"
  },
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "npm",
    "release"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "npm test",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/process-tree.test.mjs && node tests/npm-pack-json.test.mjs"
  },
  "dependencies": {
    "@firstpick/pi-utils": "^0.2.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "files": [
    "index.ts",
    "process-tree.ts",
    "*.sh",
    "README.md",
    "LICENSE"
  ]
}
